{
  "name": "3d-tiles-rendererjs-3dgs-plugin",
  "version": "0.2.2",
  "description": "Gaussian splat tile plugin for 3d-tiles-renderer backed by Gaussian Splat Lite.",
  "author": "William Liu <lyz15972107087@gmail.com>",
  "type": "module",
  "license": "Apache-2.0",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "EXT_splat_opacity.md",
    "LICENSE",
    "migration.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "check": "tsc --noEmit",
    "test": "npm run check",
    "start": "vite",
    "build-examples": "vite build",
    "prepack": "npm test && npm run build",
    "pack:check": "npm pack --dry-run && publint",
    "release:check": "npm run build-examples && npm run pack:check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WilliamLiu-1997/3D-Tiles-RendererJS-3DGS-Plugin.git"
  },
  "homepage": "https://github.com/WilliamLiu-1997/3D-Tiles-RendererJS-3DGS-Plugin#readme",
  "bugs": {
    "url": "https://github.com/WilliamLiu-1997/3D-Tiles-RendererJS-3DGS-Plugin/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "3d-tiles",
    "3d-tiles-renderer",
    "gaussian-splatting",
    "three.js",
    "gaussian-splat-lite",
    "three",
    "3dgs",
    "ecef",
    "typescript"
  ],
  "peerDependencies": {
    "3d-tiles-renderer": "^0.5.0",
    "gaussian-splat-lite": "^0.1.13",
    "three": ">=0.185.1"
  },
  "devDependencies": {
    "@types/three": "^0.185.1",
    "3d-tiles-renderer": "^0.5.0",
    "gaussian-splat-lite": "^0.1.13",
    "publint": "0.3.24",
    "three": "^0.185.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vite": "^6.4.3"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
